# All optional. CASINOGUARD runs fully without these, using local detection.

# --- Databricks as the source of truth for detection results ---
# Set to "databricks" to read alerts from Databricks instead of running detectors.
CASINOGUARD_DATA_SOURCE=local
# Workspace URL (a URL copied from the browser works; only the origin is used).
DATABRICKS_HOST=
# Personal access token or service principal token. Never commit it.
DATABRICKS_TOKEN=
# Optional: SQL warehouse to query. If unset, the workspace's warehouse is found automatically.
DATABRICKS_WAREHOUSE_ID=
# Optional table overrides (catalog.schema.table).
DATABRICKS_ALERTS_SOURCE_TABLE=workspace.default.aml_alerts_gold
DATABRICKS_TRANSACTIONS_TABLE=workspace.default.transactions_silver
DATABRICKS_ACCOUNTS_TABLE=workspace.default.accounts_silver
# Optional: reload automatically every N seconds (minimum 15). 0 = startup and manual refresh only.
# Polling runs warehouse queries and keeps the warehouse from auto-stopping, which costs money.
DATABRICKS_REFRESH_SECONDS=0
# Databricks job that runs the CASINOGUARD_AML notebook (enables "Simulate data").
# See docs/DATABRICKS_SETUP.md.
DATABRICKS_PIPELINE_JOB_ID=
DATABRICKS_UPLOAD_VOLUME=/Volumes/workspace/default/casinoguard_data
DATABRICKS_TRANSACTIONS_BRONZE_TABLE=workspace.default.transactions_bronze
DATABRICKS_ACCOUNTS_BRONZE_TABLE=workspace.default.accounts_bronze
DATABRICKS_JOB_TIMEOUT_SECONDS=1800
# How the dashboard labels the data. Use "synthetic" for generated demo data.
CASINOGUARD_DATA_CLASSIFICATION=synthetic

# --- Databricks export (local detection mode only) ---
DATABRICKS_EXPORT_TABLE=

# --- SerpApi: analyst-initiated public-web lookups ---
SERPAPI_API_KEY=

# --- Tableau: reserved for future publishing. CSV exports need no credentials. ---
TABLEAU_SERVER_URL=
TABLEAU_SITE=
TABLEAU_TOKEN=

# --- Embedded Databricks AI/BI dashboard (Databricks dashboard page) ---
# Uses DATABRICKS_HOST above. See docs/DATABRICKS_SETUP.md, "Embedded dashboard".
DATABRICKS_WORKSPACE_ID=
DATABRICKS_DASHBOARD_ID=
# Service principal with CAN RUN on the published dashboard. Its OAuth secret stays on the server.
DATABRICKS_SP_CLIENT_ID=
DATABRICKS_SP_CLIENT_SECRET=
# Optional: audit-log viewer ID (no personal data) and the value exposed as __aibi_external_value.
DATABRICKS_EMBED_VIEWER_ID=casinoguard-local-analyst
DATABRICKS_EMBED_EXTERNAL_VALUE=casinoguard
